{
  "name": "@qsp/wasm-engine",
  "version": "1.6.1",
  "type": "module",
  "description": "QSP code in WASM",
  "source": "src/index.ts",
  "main": "./dist/wasm-engine.cjs",
  "module": "./dist/wasm-engine.modern.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/wasm-engine.d.ts",
        "default": "./dist/wasm-engine.modern.js"
      },
      "require": {
        "types": "./dist/wasm-engine.d.cts",
        "default": "./dist/wasm-engine.cjs"
      }
    },
    "./wasm-engine-debug": {
      "types": "./dist/wasm-engine-debug.d.cts",
      "default": "./dist/wasm-engine-debug.cjs"
    },
    "./wasm-engine-debug.es": {
      "types": "./dist/wasm-engine-debug.d.ts",
      "default": "./dist/wasm-engine-debug.modern.js"
    },
    "./qsp-engine.wasm": "./dist/qsp-engine.wasm",
    "./qsp-engine-debug.wasm": "./dist/qsp-engine-debug.wasm"
  },
  "types": "./dist/wasm-engine.d.ts",
  "typesVersions": {
    "*": {
      "wasm-engine-debug": [
        "./dist/wasm-engine-debug.d.cts"
      ],
      "wasm-engine-debug.es": [
        "./dist/wasm-engine-debug.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "DEBUG=1 vitest run",
    "prepublish": "pnpm run build",
    "release": "np",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "update-engine": "sh ./update-engine.sh"
  },
  "keywords": [
    "qsp",
    "wasm"
  ],
  "author": "Sergii Kostyrko <srg.kostyrko@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/QSPFoundation/qsp-wasm-engine#readme",
  "bugs": {
    "url": "https://github.com/QSPFoundation/qsp-wasm-engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/QSPFoundation/qsp-wasm-engine.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@qsp/converters": "^1.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^24.19.2",
    "@types/responselike": "^1.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "np": "^12.1.1",
    "prettier": "3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.10",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "np": {
    "yarn": false
  },
  "packageManager": "pnpm@10.17.0"
}
